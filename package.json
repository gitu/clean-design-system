{
  "name": "@gitu/clean-design-system",
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "description": "A quiet, editorial design system for complex search applications.",
  "license": "MIT",
  "author": "Florian Schrag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitu/clean-design-system.git"
  },
  "homepage": "https://gitu.github.io/clean-design-system/",
  "bugs": {
    "url": "https://github.com/gitu/clean-design-system/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "component-library",
    "accessibility",
    "wcag",
    "storybook",
    "typescript",
    "css-variables",
    "search-ui",
    "charts",
    "markdown-editor",
    "date-picker",
    "shadcn-registry"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "pnpm registry && storybook dev -p 6006 --no-open",
    "build-storybook": "pnpm registry && storybook build",
    "clean": "rm -rf dist storybook-static",
    "smoke": "node scripts/smoke.mjs",
    "check-package": "node scripts/check-package.mjs",
    "registry": "node scripts/build-registry.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-tokens": "node scripts/check-tokens.mjs",
    "check-palette": "node scripts/check-series-palette.mjs",
    "shots": "node scripts/screenshot-stories.mjs --port 6006",
    "verify": "pnpm typecheck && pnpm check-tokens && pnpm check-palette && pnpm build && pnpm smoke && pnpm test",
    "prepublishOnly": "pnpm build && pnpm smoke && pnpm check-package"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "maplibre-gl": "^6.6.0",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.5.10",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@visx/curve": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0"
  }
}
